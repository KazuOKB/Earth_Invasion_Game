        .loading-panel {
            width: min(420px, 100%);
            padding: 34px 28px 30px;
            border: 1px solid rgb(135 221 255 / 45%);
            border-radius: 22px;
            background: rgb(5 12 40 / 82%);
            box-shadow: 0 24px 70px rgb(0 0 0 / 45%);
            backdrop-filter: blur(8px);
