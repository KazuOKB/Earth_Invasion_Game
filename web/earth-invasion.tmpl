            height: 46px;
            margin: 26px auto 22px;
            border: 5px solid rgb(119 221 255 / 22%);
            border-top-color: #77ddff;
            border-radius: 50%;
            animation: loading-spin 0.9s linear infinite;
            box-sizing: border-box;
        }

        #infobox.is-ready .loader {
            position: relative;
            border-color: #7ff5b1;
            animation: none;
        }

        #infobox.is-ready .loader::after {
            position: absolute;
            top: 8px;
            left: 13px;
            width: 10px;
            height: 18px;
            content: "";
            border-right: 4px solid #7ff5b1;
            border-bottom: 4px solid #7ff5b1;
            transform: rotate(45deg);
        }

        #loading-status {
            min-height: 1.5em;
            margin: 0;
            color: #e9f7ff;
            font: 700 16px/1.5 Arial, sans-serif;
